"use client";

import { useEffect, useState } from "react";
import EquipmentPage from "./components/EquipmentPage";
import ReportsPage from "./components/ReportsPage";
import NetworkPage from "./components/NetworkPage";
import ComputerPage from "./components/ComputerPage";
import CCTVPage from "./components/CCTVPage";
import TicketPage from "./components/TicketPage";
import LoginPage from "./components/LoginPage";
type CameraRequest = {
  id: string;
  borrower: string;
  department: string;
  borrowDate: string;
  returnDate: string;
  equipment: string;
  quantity: number;
  purpose: string;
  detail: string;
  status: "รออนุมัติ" | "อนุมัติแล้ว" | "กำลังใช้งาน" | "คืนแล้ว";
  createdAt: string;
};

const menuItems = [
  { icon: "🏠", name: "Dashboard" },
  { icon: "📷", name: "เบิกอุปกรณ์กล้อง" },
  { icon: "📹", name: "แจ้งปัญหากล้องวงจรปิด" },
  { icon: "🌐", name: "แจ้งปัญหา Network" },
  { icon: "💻", name: "แจ้งปัญหาคอมพิวเตอร์" },
  { icon: "🔧", name: "Ticket งาน IT" },
  { icon: "📦", name: "ทะเบียนอุปกรณ์" },
  { icon: "📊", name: "รายงาน" },
];

export default function Home() {
  const [activeMenu, setActiveMenu] = useState("Dashboard");
  const [cameraRequests, setCameraRequests] = useState<CameraRequest[]>([]);
  const [role, setRole] = useState<"USER" | "ADMIN" | null>(null);

  useEffect(() => {
    const savedRole = localStorage.getItem("it-user-role");

    if (savedRole === "USER" || savedRole === "ADMIN") {
      setRole(savedRole);
    }
  }, []);

  useEffect(() => {
    const saved = localStorage.getItem("it-camera-requests");

    if (saved) {
      try {
        setCameraRequests(JSON.parse(saved));
      } catch {
        setCameraRequests([]);
      }
    }
  }, []);

  const saveCameraRequests = (data: CameraRequest[]) => {
    setCameraRequests(data);
    localStorage.setItem("it-camera-requests", JSON.stringify(data));
  };

  const handleAddCameraRequest = (request: CameraRequest) => {
    const updated = [request, ...cameraRequests];
    saveCameraRequests(updated);
    setActiveMenu("เบิกอุปกรณ์กล้อง");
  };

  const handleUpdateStatus = (
    id: string,
    status: CameraRequest["status"]
  ) => {
    const updated = cameraRequests.map((item) =>
      item.id === id ? { ...item, status } : item
    );

    saveCameraRequests(updated);
  };

  const totalRequests = cameraRequests.length;

  const pendingRequests = cameraRequests.filter(
    (item) => item.status === "รออนุมัติ"
  ).length;

  const activeRequests = cameraRequests.filter(
    (item) =>
      item.status === "อนุมัติแล้ว" ||
      item.status === "กำลังใช้งาน"
  ).length;

  const completedRequests = cameraRequests.filter(
    (item) => item.status === "คืนแล้ว"
  ).length;

  if (!role) {
    return (
      <LoginPage
        onLogin={(loginRole) => {
          localStorage.setItem("it-user-role", loginRole);
          setRole(loginRole);
        }}
      />
    );
  }

  const visibleMenuItems =
    role === "ADMIN"
      ? menuItems
      : menuItems.filter((item) =>
          [
            "Dashboard",
            "เบิกอุปกรณ์กล้อง",
            "แจ้งปัญหากล้องวงจรปิด",
            "แจ้งปัญหา Network",
            "แจ้งปัญหาคอมพิวเตอร์",
          ].includes(item.name)
        );

  return (
    <main className="min-h-screen bg-slate-50 text-slate-800">
      <div className="flex min-h-screen">

        {/* SIDEBAR */}
        <aside className="hidden w-72 shrink-0 border-r border-slate-200 bg-white lg:flex lg:flex-col">

          <div className="border-b border-slate-100 px-6 py-6">
            <div className="flex items-center gap-3">

              <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-2xl shadow-lg shadow-blue-200">
                🛠️
              </div>

              <div>
                <h1 className="text-lg font-bold text-slate-900">
                  IT SERVICE
                </h1>

                <p className="text-xs text-slate-400">
                  IT Management Center
                </p>
              </div>

            </div>
          </div>

          <div className="flex-1 overflow-y-auto px-4 py-6">

            <p className="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
              เมนูหลัก
            </p>

            <div className="space-y-1">

              {visibleMenuItems.map((item) => {
                const active = activeMenu === item.name;

                return (
                  <button
                    key={item.name}
                    onClick={() => setActiveMenu(item.name)}
                    className={`flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium transition-all ${
                      active
                        ? "bg-blue-600 text-white shadow-md shadow-blue-200"
                        : "text-slate-600 hover:bg-slate-100"
                    }`}
                  >
                    <span className="flex w-7 justify-center text-xl">
                      {item.icon}
                    </span>

                    <span>{item.name}</span>

                  </button>
                );
              })}

            </div>

            {role === "ADMIN" && (
              <>
                <div className="my-6 border-t border-slate-100" />

                <p className="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
                  ระบบจัดการ
                </p>

                <button
                  onClick={() => setActiveMenu("ผู้ใช้งาน")}
                  className="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-100"
                >
                  <span className="flex w-7 justify-center text-xl">
                    👥
                  </span>
                  ผู้ใช้งาน
                </button>

                <button
                  onClick={() => setActiveMenu("ตั้งค่าระบบ")}
                  className="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-100"
                >
                  <span className="flex w-7 justify-center text-xl">
                    ⚙️
                  </span>
                  ตั้งค่าระบบ
                </button>
              </>
            )}

          </div>

          <div className="border-t border-slate-100 p-4">

            <div className="flex items-center gap-3 rounded-xl bg-slate-50 p-3">

              <div className="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100">
                👨‍💻
              </div>

              <div className="min-w-0">
                <p className="text-sm font-semibold text-slate-800">
                  {role === "ADMIN" ? "Administrator" : "ผู้ใช้งาน"}
                </p>

                <p className="text-xs text-slate-400">
                  {role === "ADMIN" ? "IT Admin" : "USER"}
                </p>
              </div>

              <button
                type="button"
                onClick={() => {
                  localStorage.removeItem("it-user-role");
                  setRole(null);
                }}
                className="ml-auto rounded-lg px-2 py-2 text-xs font-semibold text-red-500 hover:bg-red-50"
                title="ออกจากระบบ"
              >
                ออก
              </button>

            </div>

          </div>

        </aside>

        {/* MAIN */}
        <section className="flex min-w-0 flex-1 flex-col">

          {/* HEADER */}
          <header className="flex min-h-20 items-center justify-between border-b border-slate-200 bg-white px-5 md:px-8">

            <div>

              <p className="text-sm text-slate-400">
                IT Service Center
              </p>

              <h2 className="text-xl font-bold text-slate-900 md:text-2xl">
                {activeMenu}
              </h2>

            </div>

            <div className="flex items-center gap-3">

              <button
                className="relative flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-xl hover:bg-slate-50"
                title="การแจ้งเตือน"
              >
                🔔

                {pendingRequests > 0 && (
                  <span className="absolute right-2 top-2 h-2 w-2 rounded-full bg-red-500" />
                )}
              </button>

              <div className="hidden items-center gap-3 rounded-xl border border-slate-200 px-3 py-2 sm:flex">

                <div className="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100">
                  👨‍💻
                </div>

                <div>
                  <p className="text-xs font-semibold text-slate-800">
                    {role === "ADMIN" ? "Administrator" : "ผู้ใช้งาน"}
                  </p>

                  <p className="text-[10px] text-slate-400">
                    {role === "ADMIN" ? "IT Admin" : "USER"}
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() => {
                    localStorage.removeItem("it-user-role");
                    setRole(null);
                  }}
                  className="rounded-lg px-2 py-1 text-xs font-semibold text-red-500 hover:bg-red-50"
                  title="ออกจากระบบ"
                >
                  ออก
                </button>

              </div>

            </div>

          </header>

          {/* CONTENT */}
          <div className="flex-1 overflow-y-auto p-5 md:p-8">

            {/* MOBILE MENU */}
            <div className="mb-5 flex gap-2 overflow-x-auto pb-1 lg:hidden">

              {visibleMenuItems.map((item) => {
                const active = activeMenu === item.name;

                return (
                  <button
                    key={item.name}
                    onClick={() => setActiveMenu(item.name)}
                    className={`flex shrink-0 items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium ${
                      active
                        ? "bg-blue-600 text-white"
                        : "border border-slate-200 bg-white text-slate-600"
                    }`}
                  >
                    <span>{item.icon}</span>
                    {item.name}
                  </button>
                );
              })}

            </div>

            {/* DASHBOARD */}
            {activeMenu === "Dashboard" && (
              <Dashboard
                total={totalRequests}
                urgent={pendingRequests}
                working={activeRequests}
                completed={completedRequests}
                onCamera={() => setActiveMenu("เบิกอุปกรณ์กล้อง")}
                cameraRequests={cameraRequests}
              />
            )}

            {/* CAMERA */}
            {activeMenu === "เบิกอุปกรณ์กล้อง" && (
              <CameraPage
                requests={cameraRequests}
                onAdd={handleAddCameraRequest}
                onUpdateStatus={handleUpdateStatus}
              />
            )}

            {/* ทะเบียนอุปกรณ์ */}
{role === "ADMIN" && activeMenu === "ทะเบียนอุปกรณ์" && (
  <EquipmentPage />
)}

{/* รายงาน */}
{role === "ADMIN" && activeMenu === "รายงาน" && (
  <ReportsPage />
)}

{/* NETWORK */}
{activeMenu === "แจ้งปัญหา Network" && (
  <NetworkPage />
)}

{/* COMPUTER */}
{activeMenu === "แจ้งปัญหาคอมพิวเตอร์" && (
  <ComputerPage />
)}

{/* EQUIPMENT */}
{role === "ADMIN" && activeMenu === "ทะเบียนอุปกรณ์" && (
  <EquipmentPage />
)}

{/* REPORT */}
{role === "ADMIN" && activeMenu === "รายงาน" && (
  <ReportsPage />
)}

{/* CCTV */}
{activeMenu === "แจ้งปัญหากล้องวงจรปิด" && (
  <CCTVPage />
)}
{/* TICKET - ADMIN ONLY */}
{role === "ADMIN" && activeMenu === "Ticket งาน IT" && (
  <TicketPage />
)}

{/* เมนูที่ยังไม่ได้พัฒนา */}
{activeMenu !== "Dashboard" &&
  activeMenu !== "เบิกอุปกรณ์กล้อง" &&
  activeMenu !== "แจ้งปัญหา Network" &&
  activeMenu !== "แจ้งปัญหาคอมพิวเตอร์" &&
  activeMenu !== "Ticket งาน IT" &&
  activeMenu !== "แจ้งปัญหากล้องวงจรปิด" &&
  activeMenu !== "ทะเบียนอุปกรณ์" &&
  activeMenu !== "รายงาน" && (
    <EmptyMenu activeMenu={activeMenu} />
  )}

          </div>

        </section>

      </div>
    </main>
  );
}


/* ============================================================
   DASHBOARD
============================================================ */

function Dashboard({
  total,
  urgent,
  working,
  completed,
  onCamera,
  cameraRequests,
}: {
  total: number;
  urgent: number;
  working: number;
  completed: number;
  onCamera: () => void;
  cameraRequests: CameraRequest[];
}) {
  return (
    <div className="mx-auto max-w-7xl">

      <div className="mb-7">

        <h3 className="text-2xl font-bold text-slate-900 md:text-3xl">
          สวัสดีครับ 👋
        </h3>

        <p className="mt-1 text-sm text-slate-500">
          ยินดีต้อนรับเข้าสู่ระบบจัดการงาน IT
        </p>

      </div>

      {/* STATS */}
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <StatCard
          title="รายการเบิกทั้งหมด"
          value={total}
          detail="รายการเบิกอุปกรณ์กล้อง"
          icon="📷"
          iconBg="bg-blue-100"
        />

        <StatCard
          title="รออนุมัติ"
          value={urgent}
          detail="รายการที่รออนุมัติ"
          icon="⏳"
          iconBg="bg-orange-100"
        />

        <StatCard
          title="กำลังใช้งาน"
          value={working}
          detail="อุปกรณ์ที่กำลังถูกใช้งาน"
          icon="📸"
          iconBg="bg-purple-100"
        />

        <StatCard
          title="คืนแล้ว"
          value={completed}
          detail="รายการที่คืนอุปกรณ์แล้ว"
          icon="✅"
          iconBg="bg-green-100"
        />

      </div>

      {/* QUICK ACTION */}
      <div className="mt-8">

        <div className="mb-4">

          <h3 className="text-lg font-bold text-slate-900">
            ทำรายการ
          </h3>

          <p className="mt-1 text-sm text-slate-400">
            เลือกรายการที่ต้องการดำเนินการ
          </p>

        </div>

        <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">

          <button
            onClick={onCamera}
            className="group rounded-2xl border border-slate-200 bg-white p-5 text-left transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
          >

            <div className="flex items-center gap-4">

              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl group-hover:bg-blue-100">
                📷
              </div>

              <div>

                <h4 className="font-bold text-slate-900">
                  เบิกอุปกรณ์กล้อง
                </h4>

                <p className="mt-1 text-xs text-slate-400">
                  บันทึกการเบิกใช้อุปกรณ์กล้อง
                </p>

              </div>

            </div>

            <div className="mt-5 text-right text-xs font-semibold text-blue-600">
              เปิดรายการ →
            </div>

          </button>

          <button
            disabled
            className="cursor-not-allowed rounded-2xl border border-slate-200 bg-white p-5 text-left opacity-60"
          >

            <div className="flex items-center gap-4">

              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-cyan-50 text-2xl">
                🌐
              </div>

              <div>

                <h4 className="font-bold text-slate-900">
                  แจ้งปัญหา Network
                </h4>

                <p className="mt-1 text-xs text-slate-400">
                  กำลังเตรียมระบบ
                </p>

              </div>

            </div>

          </button>

          <button
            disabled
            className="cursor-not-allowed rounded-2xl border border-slate-200 bg-white p-5 text-left opacity-60"
          >

            <div className="flex items-center gap-4">

              <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-50 text-2xl">
                💻
              </div>

              <div>

                <h4 className="font-bold text-slate-900">
                  แจ้งปัญหาคอมพิวเตอร์
                </h4>

                <p className="mt-1 text-xs text-slate-400">
                  กำลังเตรียมระบบ
                </p>

              </div>

            </div>

          </button>

        </div>

      </div>

      {/* RECENT CAMERA */}
      <div className="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white">

        <div className="border-b border-slate-100 px-5 py-5">

          <h3 className="font-bold text-slate-900">
            รายการเบิกอุปกรณ์ล่าสุด
          </h3>

          <p className="mt-1 text-xs text-slate-400">
            รายการเบิกกล้องล่าสุดจากระบบ
          </p>

        </div>

        {cameraRequests.length === 0 ? (
          <EmptyState
            icon="📭"
            title="ยังไม่มีรายการเบิกอุปกรณ์"
            description="เมื่อมีการเบิกอุปกรณ์ รายการจะแสดงที่นี่"
          />
        ) : (
          <div className="divide-y divide-slate-100">

            {cameraRequests.slice(0, 5).map((item) => (
              <div
                key={item.id}
                className="flex flex-col gap-3 px-5 py-4 md:flex-row md:items-center md:justify-between"
              >

                <div className="flex items-center gap-3">

                  <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-xl">
                    📷
                  </div>

                  <div>

                    <p className="text-sm font-bold text-slate-800">
                      {item.equipment}
                    </p>

                    <p className="mt-1 text-xs text-slate-400">
                      {item.id} · {item.borrower} · จำนวน {item.quantity}
                    </p>

                  </div>

                </div>

                <StatusBadge status={item.status} />

              </div>
            ))}

          </div>
        )}

      </div>

    </div>
  );
}


/* ============================================================
   CAMERA PAGE
============================================================ */

function CameraPage({
  requests,
  onAdd,
  onUpdateStatus,
}: {
  requests: CameraRequest[];
  onAdd: (request: CameraRequest) => void;
  onUpdateStatus: (
    id: string,
    status: CameraRequest["status"]
  ) => void;
}) {
  const [showForm, setShowForm] = useState(false);

  const [borrower, setBorrower] = useState("");
  const [department, setDepartment] = useState("");
  const [borrowDate, setBorrowDate] = useState("");
  const [returnDate, setReturnDate] = useState("");
  const [equipment, setEquipment] = useState("");
  const [quantity, setQuantity] = useState("1");
  const [purpose, setPurpose] = useState("");
  const [detail, setDetail] = useState("");

  const resetForm = () => {
    setBorrower("");
    setDepartment("");
    setBorrowDate("");
    setReturnDate("");
    setEquipment("");
    setQuantity("1");
    setPurpose("");
    setDetail("");
  };

  const submitForm = (e: React.FormEvent) => {
    e.preventDefault();

    if (
      !borrower ||
      !department ||
      !borrowDate ||
      !returnDate ||
      !equipment ||
      !purpose
    ) {
      alert("กรุณากรอกข้อมูลที่มีเครื่องหมาย * ให้ครบ");
      return;
    }

    const now = new Date();

    const id =
      "CAM-" +
      now.getFullYear() +
      "-" +
      String(Date.now()).slice(-5);

    const request: CameraRequest = {
      id,
      borrower,
      department,
      borrowDate,
      returnDate,
      equipment,
      quantity: Number(quantity),
      purpose,
      detail,
      status: "รออนุมัติ",
      createdAt: now.toISOString(),
    };

    onAdd(request);

    resetForm();
    setShowForm(false);

    alert("บันทึกคำขอเบิกอุปกรณ์เรียบร้อยแล้ว");
  };

  return (
    <div className="mx-auto max-w-7xl">

      {/* PAGE HEADER */}
      <div className="mb-7 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

        <div>

          <div className="flex items-center gap-3">

            <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-2xl">
              📷
            </div>

            <div>

              <h3 className="text-2xl font-bold text-slate-900">
                เบิกอุปกรณ์กล้อง
              </h3>

              <p className="mt-1 text-sm text-slate-400">
                บันทึกและติดตามการเบิกใช้อุปกรณ์กล้อง
              </p>

            </div>

          </div>

        </div>

        <button
          onClick={() => setShowForm(!showForm)}
          className="rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700"
        >
          {showForm ? "✕ ปิดแบบฟอร์ม" : "+ เบิกอุปกรณ์"}
        </button>

      </div>


      {/* SUMMARY */}
      <div className="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <MiniStat
          title="ทั้งหมด"
          value={requests.length}
          icon="📋"
        />

        <MiniStat
          title="รออนุมัติ"
          value={requests.filter((x) => x.status === "รออนุมัติ").length}
          icon="⏳"
        />

        <MiniStat
          title="กำลังใช้งาน"
          value={
            requests.filter(
              (x) =>
                x.status === "อนุมัติแล้ว" ||
                x.status === "กำลังใช้งาน"
            ).length
          }
          icon="📸"
        />

        <MiniStat
          title="คืนแล้ว"
          value={requests.filter((x) => x.status === "คืนแล้ว").length}
          icon="✅"
        />

      </div>


      {/* FORM */}
      {showForm && (
        <form
          onSubmit={submitForm}
          className="mb-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-7"
        >

          <div className="mb-6">

            <h4 className="text-lg font-bold text-slate-900">
              แบบฟอร์มเบิกอุปกรณ์กล้อง
            </h4>

            <p className="mt-1 text-xs text-slate-400">
              กรุณากรอกข้อมูลให้ครบก่อนส่งคำขอ
            </p>

          </div>


          <div className="grid gap-5 md:grid-cols-2">

            <FormInput
              label="ผู้เบิก"
              required
              value={borrower}
              onChange={setBorrower}
              placeholder="ชื่อ - นามสกุล"
            />

            <FormInput
              label="สาขา / แผนก"
              required
              value={department}
              onChange={setDepartment}
              placeholder="เช่น สำนักงานใหญ่ / IT"
            />

            <FormInput
              label="วันที่เบิก"
              required
              type="date"
              value={borrowDate}
              onChange={setBorrowDate}
            />

            <FormInput
              label="วันที่ต้องการคืน"
              required
              type="date"
              value={returnDate}
              onChange={setReturnDate}
            />

            <div>

              <label className="mb-2 block text-sm font-semibold text-slate-700">
                อุปกรณ์ที่ต้องการเบิก <span className="text-red-500">*</span>
              </label>

              <select
                value={equipment}
                onChange={(e) => setEquipment(e.target.value)}
                className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
              >

                <option value="">
                  -- เลือกอุปกรณ์ --
                </option>

                <option value="กล้องถ่ายภาพ">
                  📷 กล้องถ่ายภาพ
                </option>

                <option value="กล้องวิดีโอ">
                  🎥 กล้องวิดีโอ
                </option>

                <option value="กล้องวงจรปิด">
                  📹 กล้องวงจรปิด
                </option>

                <option value="ขาตั้งกล้อง">
                  📐 ขาตั้งกล้อง
                </option>

                <option value="ไมโครโฟน">
                  🎙️ ไมโครโฟน
                </option>

                <option value="ไฟสตูดิโอ">
                  💡 ไฟสตูดิโอ
                </option>

                <option value="อุปกรณ์เสริม">
                  🧰 อุปกรณ์เสริม
                </option>

              </select>

            </div>


            <div>

              <label className="mb-2 block text-sm font-semibold text-slate-700">
                จำนวน <span className="text-red-500">*</span>
              </label>

              <input
                type="number"
                min="1"
                value={quantity}
                onChange={(e) => setQuantity(e.target.value)}
                className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
              />

            </div>

          </div>


          <div className="mt-5">

            <label className="mb-2 block text-sm font-semibold text-slate-700">
              วัตถุประสงค์การใช้งาน <span className="text-red-500">*</span>
            </label>

            <textarea
              value={purpose}
              onChange={(e) => setPurpose(e.target.value)}
              rows={3}
              placeholder="ระบุวัตถุประสงค์ เช่น ใช้ถ่ายกิจกรรมบริษัท"
              className="w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
            />

          </div>


          <div className="mt-5">

            <label className="mb-2 block text-sm font-semibold text-slate-700">
              รายละเอียดเพิ่มเติม
            </label>

            <textarea
              value={detail}
              onChange={(e) => setDetail(e.target.value)}
              rows={3}
              placeholder="รายละเอียดเพิ่มเติม (ถ้ามี)"
              className="w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
            />

          </div>


          <div className="mt-6 flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">

            <button
              type="button"
              onClick={() => {
                resetForm();
                setShowForm(false);
              }}
              className="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50"
            >
              ยกเลิก
            </button>

            <button
              type="submit"
              className="rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-200 hover:bg-blue-700"
            >
              💾 บันทึกคำขอเบิก
            </button>

          </div>

        </form>
      )}


      {/* HISTORY */}
      <div className="overflow-hidden rounded-2xl border border-slate-200 bg-white">

        <div className="border-b border-slate-100 px-5 py-5">

          <h4 className="font-bold text-slate-900">
            ประวัติการเบิกอุปกรณ์
          </h4>

          <p className="mt-1 text-xs text-slate-400">
            รายการเบิกทั้งหมดในระบบ
          </p>

        </div>


        {requests.length === 0 ? (
          <EmptyState
            icon="📷"
            title="ยังไม่มีรายการเบิก"
            description="กดปุ่ม “เบิกอุปกรณ์” เพื่อสร้างรายการแรก"
          />
        ) : (
          <div className="overflow-x-auto">

            <table className="w-full min-w-[900px] text-left">

              <thead className="bg-slate-50">

                <tr>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    เลขที่
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    ผู้เบิก
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    อุปกรณ์
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    จำนวน
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    วันที่เบิก
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    วันที่คืน
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    สถานะ
                  </th>

                  <th className="px-5 py-4 text-xs font-semibold text-slate-500">
                    จัดการ
                  </th>

                </tr>

              </thead>

              <tbody className="divide-y divide-slate-100">

                {requests.map((item) => (

                  <tr
                    key={item.id}
                    className="hover:bg-slate-50"
                  >

                    <td className="px-5 py-4 text-xs font-semibold text-blue-600">
                      {item.id}
                    </td>

                    <td className="px-5 py-4">

                      <p className="text-sm font-semibold text-slate-800">
                        {item.borrower}
                      </p>

                      <p className="mt-1 text-xs text-slate-400">
                        {item.department}
                      </p>

                    </td>

                    <td className="px-5 py-4 text-sm text-slate-700">
                      {item.equipment}
                    </td>

                    <td className="px-5 py-4 text-sm font-semibold">
                      {item.quantity}
                    </td>

                    <td className="px-5 py-4 text-sm text-slate-600">
                      {formatDate(item.borrowDate)}
                    </td>

                    <td className="px-5 py-4 text-sm text-slate-600">
                      {formatDate(item.returnDate)}
                    </td>

                    <td className="px-5 py-4">
                      <StatusBadge status={item.status} />
                    </td>

                    <td className="px-5 py-4">

                      <select
                        value={item.status}
                        onChange={(e) =>
                          onUpdateStatus(
                            item.id,
                            e.target.value as CameraRequest["status"]
                          )
                        }
                        className="rounded-lg border border-slate-200 px-2 py-2 text-xs outline-none focus:border-blue-500"
                      >

                        <option value="รออนุมัติ">
                          รออนุมัติ
                        </option>

                        <option value="อนุมัติแล้ว">
                          อนุมัติแล้ว
                        </option>

                        <option value="กำลังใช้งาน">
                          กำลังใช้งาน
                        </option>

                        <option value="คืนแล้ว">
                          คืนแล้ว
                        </option>

                      </select>

                    </td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>
        )}

      </div>

    </div>
  );
}


/* ============================================================
   FORM INPUT
============================================================ */

function FormInput({
  label,
  required,
  value,
  onChange,
  placeholder,
  type = "text",
}: {
  label: string;
  required?: boolean;
  value: string;
  onChange: (value: string) => void;
  placeholder?: string;
  type?: string;
}) {
  return (
    <div>

      <label className="mb-2 block text-sm font-semibold text-slate-700">

        {label}

        {required && (
          <span className="text-red-500"> *</span>
        )}

      </label>

      <input
        type={type}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        placeholder={placeholder}
        className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-50"
      />

    </div>
  );
}


/* ============================================================
   STAT CARD
============================================================ */

function StatCard({
  title,
  value,
  detail,
  icon,
  iconBg,
}: {
  title: string;
  value: number;
  detail: string;
  icon: string;
  iconBg: string;
}) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg">

      <div className="flex items-start justify-between">

        <div>

          <p className="text-sm font-medium text-slate-500">
            {title}
          </p>

          <p className="mt-2 text-4xl font-bold text-slate-900">
            {value}
          </p>

        </div>

        <div
          className={`flex h-12 w-12 items-center justify-center rounded-xl text-2xl ${iconBg}`}
        >
          {icon}
        </div>

      </div>

      <p className="mt-5 text-xs text-slate-400">
        {detail}
      </p>

    </div>
  );
}


/* ============================================================
   MINI STAT
============================================================ */

function MiniStat({
  title,
  value,
  icon,
}: {
  title: string;
  value: number;
  icon: string;
}) {
  return (
    <div className="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-5">

      <div>

        <p className="text-xs text-slate-400">
          {title}
        </p>

        <p className="mt-1 text-2xl font-bold text-slate-900">
          {value}
        </p>

      </div>

      <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-50 text-xl">
        {icon}
      </div>

    </div>
  );
}


/* ============================================================
   STATUS
============================================================ */

function StatusBadge({
  status,
}: {
  status: CameraRequest["status"];
}) {
  const style =
    status === "รออนุมัติ"
      ? "bg-orange-50 text-orange-600"
      : status === "อนุมัติแล้ว"
      ? "bg-blue-50 text-blue-600"
      : status === "กำลังใช้งาน"
      ? "bg-purple-50 text-purple-600"
      : "bg-green-50 text-green-600";

  return (
    <span
      className={`inline-flex rounded-full px-3 py-1.5 text-xs font-semibold ${style}`}
    >
      {status}
    </span>
  );
}


/* ============================================================
   EMPTY STATE
============================================================ */

function EmptyState({
  icon,
  title,
  description,
}: {
  icon: string;
  title: string;
  description: string;
}) {
  return (
    <div className="px-5 py-14 text-center">

      <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-3xl">
        {icon}
      </div>

      <p className="mt-4 text-sm font-semibold text-slate-600">
        {title}
      </p>

      <p className="mt-1 text-xs text-slate-400">
        {description}
      </p>

    </div>
  );
}


/* ============================================================
   EMPTY MENU
============================================================ */

function EmptyMenu({
  activeMenu,
}: {
  activeMenu: string;
}) {
  return (
    <div className="mx-auto max-w-7xl">

      <div className="rounded-2xl border border-slate-200 bg-white p-10 md:p-16">

        <div className="mx-auto max-w-lg text-center">

          <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-blue-50 text-4xl">
            {getMenuIcon(activeMenu)}
          </div>

          <h3 className="mt-5 text-xl font-bold text-slate-900">
            {activeMenu}
          </h3>

          <p className="mt-2 text-sm leading-6 text-slate-400">
            หน้านี้กำลังเตรียมระบบ
          </p>

          <div className="mt-6 rounded-xl bg-slate-50 p-4 text-xs text-slate-400">
            ยังไม่มีข้อมูลในระบบ
          </div>

        </div>

      </div>

    </div>
  );
}


/* ============================================================
   ICON
============================================================ */

function getMenuIcon(name: string) {
  switch (name) {
    case "เบิกอุปกรณ์กล้อง":
      return "📷";

    case "แจ้งปัญหา Network":
      return "🌐";

    case "แจ้งปัญหาคอมพิวเตอร์":
      return "💻";

    case "Ticket งาน IT":
      return "🔧";

    case "ทะเบียนอุปกรณ์":
      return "📦";

    case "รายงาน":
      return "📊";

    case "ผู้ใช้งาน":
      return "👥";

    case "ตั้งค่าระบบ":
      return "⚙️";

    default:
      return "🛠️";
  }
}


/* ============================================================
   DATE
============================================================ */

function formatDate(date: string) {
  if (!date) return "-";

  const [year, month, day] = date.split("-");

  if (!year || !month || !day) return date;

  return `${day}/${month}/${year}`;
}